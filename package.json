{
  "name": "luminix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fly:validate": "flyctl config validate --config apps/api/fly.toml",
    "fly:deploy": "flyctl deploy . --remote-only --config apps/api/fly.toml",
    "vercel:pull": "vercel pull --yes --environment=preview --cwd apps/admin",
    "vercel:build": "vercel build --cwd apps/admin",
    "vercel:preview": "vercel deploy --cwd apps/admin",
    "vercel:production": "vercel deploy --prod --cwd apps/admin"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
