{
  "name": "luminix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "remove": "node scripts/clean-workspace.mjs",
    "remove:preview": "node scripts/clean-workspace.mjs --dry-run",
    "dev": "pnpm --recursive --parallel --if-present dev",
    "dev:admin": "pnpm --filter @luminix/admin dev",
    "dev:web": "pnpm --filter @luminix/web dev",
    "dev:api": "pnpm --filter @luminix/api dev",
    "dev:mobile-admin": "pnpm --filter @luminix/mobile-admin dev",
    "dev:mobile-client": "pnpm --filter @luminix/mobile-client dev",
    "build": "pnpm --recursive --if-present build",
    "build:admin": "pnpm --filter @luminix/admin build",
    "build:web": "pnpm --filter @luminix/web build",
    "build:api": "pnpm --filter @luminix/api build",
    "build:mobile-client": "pnpm --filter @luminix/mobile-client build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "typecheck:admin": "pnpm --filter @luminix/admin typecheck",
    "typecheck:web": "pnpm --filter @luminix/web typecheck",
    "typecheck:api": "pnpm --filter @luminix/api typecheck",
    "typecheck:mobile-admin": "pnpm --filter @luminix/mobile-admin typecheck",
    "typecheck:mobile-client": "pnpm --filter @luminix/mobile-client typecheck",
    "lint": "pnpm --recursive --if-present lint",
    "lint:admin": "pnpm --filter @luminix/admin lint",
    "lint:web": "pnpm --filter @luminix/web lint",
    "lint:api": "pnpm --filter @luminix/api lint",
    "lint:mobile-admin": "pnpm --filter @luminix/mobile-admin lint",
    "lint:mobile-client": "pnpm --filter @luminix/mobile-client lint",
    "test": "pnpm --recursive --if-present test",
    "test:api": "pnpm --filter @luminix/api test",
    "test:web": "pnpm --filter @luminix/web test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fly:validate": "flyctl config validate --config apps/api/fly.toml",
    "fly:deploy": "flyctl deploy . --remote-only --config apps/api/fly.toml",
    "vercel:admin:pull": "vercel pull --yes --environment=preview --project luminix-admin",
    "vercel:admin:preview": "vercel deploy . --project luminix-admin",
    "vercel:admin:production": "vercel deploy . --prod --project luminix-admin",
    "vercel:web:pull": "vercel pull --yes --environment=preview --project luminix-web",
    "vercel:web:preview": "vercel deploy . --target preview --project luminix-web",
    "vercel:web:production": "vercel deploy . --prod --project luminix-web",
    "vercel:client:pull": "vercel pull --yes --environment=preview --project luminix-client",
    "vercel:client:preview": "vercel deploy . --project luminix-client",
    "vercel:client:production": "vercel deploy . --prod --project luminix-client"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
