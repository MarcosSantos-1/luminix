# Origem do site Luminix: o app lê dele a busca e os dados públicos dos espaços.
EXPO_PUBLIC_WEB_URL=https://luminix.beauty

# API da conta do cliente (ficha, espaços, agendamentos). Produção: https://luminix-api.fly.dev
EXPO_PUBLIC_API_URL=http://localhost:3333

# Login da cliente: mesmo projeto Firebase do site e do admin (valores públicos).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
