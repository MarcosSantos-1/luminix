# API usada pelo navegador na área do cliente (/cliente). Produção: https://luminix-api.fly.dev
NEXT_PUBLIC_API_URL=http://localhost:3333

# Login da cliente (mesmo projeto Firebase do Luminix; valores públicos, como no admin).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Durante desenvolvimento, pode apontar para http://localhost:3000.
NEXT_PUBLIC_ADMIN_URL=https://app.luminix.beauty

# Consulta pública server-side; nenhuma credencial de banco no web.
API_URL=https://luminix-api.fly.dev
# Nunca incluir secrets em NEXT_PUBLIC_*.
CLINIC_CACHE_SECRET=
