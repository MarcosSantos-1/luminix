NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Reservadas para as próximas integrações. Ainda não são consumidas pelo bootstrap.
DATABASE_URL=postgresql://user:password@host-pooler.example/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@host.example/neondb?sslmode=verify-full
DATABASE_POOL_MAX=10
FIREBASE_PROJECT_ID=
# Desenvolvimento local: caminho absoluto para um JSON de service account fora do repositório.
GOOGLE_APPLICATION_CREDENTIALS=
# Deploy: alternativa ao arquivo local. Configure os dois valores juntos.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
