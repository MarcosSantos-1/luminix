NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Credenciais operacionais: runtime separado do proprietário/runner de migrations.
DATABASE_URL_RUNTIME=postgresql://luminix_api:password@host-pooler.example/neondb?sslmode=verify-full
DATABASE_URL=postgresql://user:password@host-pooler.example/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@host.example/neondb?sslmode=verify-full
DATABASE_POOL_MAX=10
FIREBASE_PROJECT_ID=
# Local: arquivo privado ignorado pelo Git; caminho relativo a apps/api (pnpm dev:api).
GOOGLE_APPLICATION_CREDENTIALS=../../.secrets/firebase-admin.json
# Deploy: alternativa ao arquivo local. Configure os dois valores juntos.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
